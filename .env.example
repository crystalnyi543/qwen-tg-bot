# ─────────────────────────────────────────────
#  Конфигурация бота — скопируй в .env и заполни
# ─────────────────────────────────────────────

# Telegram Bot Token (получи у @BotFather)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# DashScope API Key (qwen) — регистрация: https://dashscope.aliyuncs.com
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY_HERE

# Модель Qwen: qwen-plus | qwen-max | qwen-turbo | qwen-long
QWEN_MODEL=qwen-plus
